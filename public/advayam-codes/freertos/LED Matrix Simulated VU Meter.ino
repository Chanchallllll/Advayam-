/*
 * =============================================================================
 * 5x5 RGB VU METER - FreeRTOS VERSION
 * =============================================================================
 *
 * Simulates a five-bar audio VU meter on the 5x5 RGB matrix.
 *
 * Each column represents one audio level.
 *
 * - Random peaks simulate audio.
 * - Bars decay over time.
 * - Bars grow from TOP to BOTTOM.
 * - Green = lower levels.
 * - Orange = higher levels.
 *
 * Matrix:
 *
 *   0  1  2  3  4
 *   ↓  ↓  ↓  ↓  ↓
 *   █  █  █  █  █
 *   █  █  █  █  █
 *   █  █  █  █  █
 *   █  █  █  █  █
 *   █  █  █  █  █
 *
 *
 * FreeRTOS:
 *
 *   VUMeterTask
 *       |
 *       +-- Generate random peaks
 *       +-- Apply decay
 *       +-- Draw matrix
 *
 * Matrix = GPIO 7
 * =============================================================================
 */

#include <Arduino.h>
#include <Adafruit_NeoPixel.h>


// =============================================================================
// Pins
// =============================================================================

#define MATRIX_PIN 7
#define NUM_LEDS   25


// =============================================================================
// Matrix
// =============================================================================

Adafruit_NeoPixel matrix(
  NUM_LEDS,
  MATRIX_PIN,
  NEO_GRB + NEO_KHZ800
);


// =============================================================================
// VU Meter
// =============================================================================

int barss[5];


// =============================================================================
// Matrix Coordinate Conversion
// =============================================================================

int pixelXY(
  int x,
  int y
)
{
  // Even rows run left to right.
  if (y % 2 == 0)
  {
    return y * 5 + x;
  }

  // Odd rows run right to left.
  return y * 5 + (4 - x);
}


// =============================================================================
// Draw VU Meter
// =============================================================================

void drawMeter()
{
  matrix.clear();


  // ---------------------------------------------------------------------------
  // Draw each of the five bars.
  // ---------------------------------------------------------------------------

  for (int x = 0; x < 5; x++)
  {
    for (int level = 0;
         level < barss[x];
         level++)
    {
      // Bars grow from TOP to BOTTOM.
      int y = level;


      uint32_t color;


      // -----------------------------------------------------------------------
      // Lower levels = green.
      // -----------------------------------------------------------------------

      if (level < 3)
      {
        color = matrix.Color(
          0,
          255,
          0
        );
      }

      // -----------------------------------------------------------------------
      // Upper levels = orange.
      // -----------------------------------------------------------------------

      else
      {
        color = matrix.Color(
          255,
          80,
          0
        );
      }


      matrix.setPixelColor(
        pixelXY(x, y),
        color
      );
    }
  }


  matrix.show();
}


// =============================================================================
// FreeRTOS VU Meter Task
// =============================================================================

void VUMeterTask(
  void *parameter
)
{
  while (true)
  {
    // -------------------------------------------------------------------------
    // Generate random peaks and apply decay.
    // -------------------------------------------------------------------------

    for (int i = 0; i < 5; i++)
    {
      // Random peak.
      if (random(100) < 40)
      {
        barss[i] =
          random(1, 6);
      }

      // Otherwise decay the current bar.
      else if (barss[i] > 0)
      {
        barss[i]--;
      }
    }


    // -------------------------------------------------------------------------
    // Update the display.
    // -------------------------------------------------------------------------

    drawMeter();


    // -------------------------------------------------------------------------
    // Update approximately every 120 ms.
    //
    // vTaskDelay() allows other FreeRTOS tasks to run instead
    // of blocking the CPU with delay().
    // -------------------------------------------------------------------------

    vTaskDelay(
      pdMS_TO_TICKS(120)
    );
  }
}


// =============================================================================
// Setup
// =============================================================================

void setup()
{
  Serial.begin(115200);


  // ---------------------------------------------------------------------------
  // Initialize matrix.
  // ---------------------------------------------------------------------------

  matrix.begin();

  matrix.setBrightness(25);

  matrix.clear();

  matrix.show();


  // ---------------------------------------------------------------------------
  // Seed random number generator.
  // ---------------------------------------------------------------------------

  randomSeed(
    analogRead(1)
  );


  // ---------------------------------------------------------------------------
  // Initialize bars.
  // ---------------------------------------------------------------------------

  for (int i = 0; i < 5; i++)
  {
    barss[i] = 0;
  }


  // ---------------------------------------------------------------------------
  // Create FreeRTOS task.
  // ---------------------------------------------------------------------------

  xTaskCreatePinnedToCore(
    VUMeterTask,        // Task function
    "VUMeterTask",      // Task name
    2048,               // Stack size
    NULL,               // Parameter
    1,                  // Priority
    NULL,               // Task handle
    1                   // Core
  );


  Serial.println(
    "FreeRTOS VU Meter started."
  );
}


// =============================================================================
// Arduino Loop
// =============================================================================

void loop()
{
  // ---------------------------------------------------------------------------
  // Everything is handled by the FreeRTOS task.
  // ---------------------------------------------------------------------------

  vTaskDelay(
    pdMS_TO_TICKS(1000)
  );
}
